{
  "name": "belouga-tournament",
  "version": "1.12.3",
  "description": "Production-ready e-sports tournament management platform with Discord auth, Stripe payments, and an admin back office",
  "homepage": "https://github.com/henchoznoe/BelougaTournament",
  "bugs": {
    "url": "https://github.com/henchoznoe/BelougaTournament/issues",
    "email": "henchoznoe@gmail.com"
  },
  "license": "MIT",
  "author": "Noé Henchoz <henchoznoe@gmail.com> (https://henchoznoe.ch/)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henchoznoe/BelougaTournament.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/deploy-production-migrations.ts && next build --webpack && pnpm verify:build",
    "verify:build": "node scripts/verify-build-quality.ts",
    "vercel:ignore-build": "node scripts/should-ignore-vercel-build.ts",
    "start": "next start",
    "prepare": "lefthook install",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:all": "biome check --write . && knip",
    "check:com": "biome check --write . && knip && vitest run && tsc --noEmit && pnpm build",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "stripe:listen": "tsx scripts/stripe-listen.ts",
    "stripe:listen:live": "tsx scripts/stripe-listen.ts --live"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.1",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "posthog-node": "^5.50.0",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-quill-new": "^3.8.3",
    "resend": "^6.22.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.26",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
